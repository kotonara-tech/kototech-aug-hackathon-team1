# Optional URL override for page metadata.
# Keep this blank for local development; the app will use the localhost request URL.
APP_URL=

# Not used by the current prototype. Add these when live place/route lookup is implemented.
# Keep the server key private and restrict it to the required Google Maps APIs.
GOOGLE_MAPS_API_KEY=

# Only use this browser-visible key for client-side Maps/Street View rendering.
# Restrict it by HTTP referrer and enabled APIs.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Reserved for a future authorized Nara City / SYMONS integration.
# Do not populate this by reverse-engineering a private mobile API.
SHIKA_NO_ASHIATO_API_BASE_URL=
SHIKA_NO_ASHIATO_API_KEY=
